{
  "name": "web3ashley",
  "private": true,
  "scripts": {
    "dev": "npx wrangler pages dev .",
    "deploy": "npx wrangler pages deploy . --project-name=web3ashley",
    "deploy:poster": "npx wrangler deploy --config poster/wrangler.toml",
    "secret": "npx wrangler pages secret put RESEND_API_KEY",
    "serve": "python3 -m http.server 8080",
    "draft": "python3 tools/draft_article.py",
    "seed": "python3 tools/seed_d1.py && python3 tools/seed_content.py",
    "backup": "npx wrangler d1 export web3ashley --remote --output=journal-backup.sql",
    "seed:build": "python3 tools/build_seed.py",
    "check": "python3 tools/stamp_assets.py --check && node tools/check_brand.mjs && node tools/check_studio.mjs && node tools/check_nav.mjs && node tools/check_social.mjs && node tools/check_mcp.mjs && node tools/check_designer.mjs && node tools/check_oauth.mjs && node tools/check_poster.mjs && node tools/check_insights.mjs && node tools/check_tiktok.mjs && node tools/check_instagram.mjs && node tools/check_imagen.mjs && node tools/check_paint.mjs",
    "check:nav": "node tools/check_nav.mjs",
    "check:studio": "node tools/check_studio.mjs",
    "check:social": "node tools/check_social.mjs",
    "check:mcp": "node tools/check_mcp.mjs",
    "check:oauth": "node tools/check_oauth.mjs",
    "check:poster": "node tools/check_poster.mjs",
    "check:insights": "node tools/check_insights.mjs",
    "check:tiktok": "node tools/check_tiktok.mjs",
    "check:instagram": "node tools/check_instagram.mjs",
    "check:imagen": "node tools/check_imagen.mjs",
    "check:brand": "node tools/check_brand.mjs",
    "stamp": "python3 tools/stamp_assets.py",
    "icons": "python3 tools/service_icons.py",
    "appicon": "node tools/app_icon.mjs"
  },
  "type": "module"
}
