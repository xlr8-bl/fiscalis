/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload

# `immutable` is a promise that the bytes at a URL will never change. It can
# only be kept when the version is in the filename, and these filenames have
# no version in them — so a browser that had once fetched site.css would hold
# it for a year and never see another change. New markup arrived against a
# year-old stylesheet, which is worse than no caching at all.
#
# These revalidate instead: the browser still caches, and still asks. An
# unchanged file comes back as a 304 with no body, which is cheap. When the
# filenames carry a content hash, immutable can come back.
/assets/js/*
  Cache-Control: public, max-age=0, must-revalidate
/assets/css/*
  Cache-Control: public, max-age=0, must-revalidate

# These genuinely do not change. A font is replaced by adding another file,
# and the stock images are part of the build.
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/assets/stock/*
  Cache-Control: public, max-age=31536000, immutable

# Uploaded images are written once under a key that already contains a random
# suffix, so those are safe to pin.
/media/*
  Cache-Control: public, max-age=31536000, immutable

/api/*
  Cache-Control: no-store

/
  Cache-Control: public, max-age=0, must-revalidate

/journal/*
  Cache-Control: public, max-age=0, must-revalidate

/feed.xml
  Cache-Control: public, max-age=3600
